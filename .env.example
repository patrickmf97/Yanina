# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# === Usadas só pelas funções de servidor (pasta /api) — NUNCA levam prefixo VITE_ ===
# Mesma URL de cima, mas sem o VITE_ (as functions rodam fora do navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings > API > service_role (secreta! nunca exponha isso no frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Suas integrações > credenciais de PRODUÇÃO (ou teste, pra testar antes)
MERCADOPAGO_ACCESS_TOKEN=

# URL pública do site em produção (sem barra no final), usada nos links de retorno do checkout
SITE_URL=https://yaniterapia.vercel.app
